# Port web dashboard
PORT=3000

# Kunci rahasia untuk session & enkripsi password router (WAJIB diganti, min. 32 karakter acak)
APP_SECRET=ganti-dengan-string-acak-yang-panjang-sekali-123456

# Akun admin awal (hanya dipakai saat database pertama kali dibuat)
ADMIN_USER=admin
ADMIN_PASS=admin123

# Interval polling realtime (detik)
POLL_INTERVAL=5

# Lama penyimpanan riwayat (hari)
RETENTION_DAYS=30

# true = pakai router simulasi (demo tanpa perangkat MikroTik)
SIMULATE=false
